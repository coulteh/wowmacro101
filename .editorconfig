# Formatting conventions for this repo. WebStorm and other JetBrains IDEs honour
# this natively, so Reformat Code should be close to a no-op.
# Measured from the code as written, not aspirational.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,mjs,js,mts,cts}]
max_line_length = 120
quote_type = single

# The command, conditional and unit dictionaries are deliberately tabular -- some
# entries are one dense line each. Leave their width alone.
[src/data/*.ts]
max_line_length = off

[*.{json,html,css}]
max_line_length = 120

# Generated by scripts/build-spell-data.mjs: ~19,000 names on a single 410 kB line.
# Never edit it by hand, and do not let an editor try to reflow it.
[src/data/spells.retail.json]
max_line_length = off
insert_final_newline = true

[package-lock.json]
max_line_length = off

# Two trailing spaces are a hard line break in Markdown, so leave them be.
[*.md]
max_line_length = off
trim_trailing_whitespace = false
