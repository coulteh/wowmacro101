    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:spells": "node scripts/build-spell-data.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
