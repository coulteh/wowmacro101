{
  "name": "wowmacro101",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A regex101-style explainer for World of Warcraft macros.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
